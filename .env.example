# Copy to .env and adjust. All settings are optional.

# Port the app listens on (open http://<host-ip>:5180 on other devices)
LI_PORT=5180

# 0.0.0.0 = reachable from your home network; 127.0.0.1 = this computer only
LI_HOST=0.0.0.0

# Optional access PIN asked once per browser (recommended on shared networks)
# LI_ACCESS_PIN=2468

# Default research update interval in hours (can also be changed in the app)
LI_UPDATE_INTERVAL_HOURS=12

# Where the databases, backups and downloaded map live
# LI_DATA_DIR=data

# Number of automatic daily progress backups to keep
LI_BACKUP_KEEP=30

# true = never contact the internet (uses cached/pinned data)
LI_OFFLINE=false

# Only change if you really need access from non-private IP ranges (NOT recommended)
LI_ALLOW_PUBLIC_IPS=false
